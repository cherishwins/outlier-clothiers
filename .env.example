# ==============================================
# Outlier Clothiers - environment for the Docker deploy
# ==============================================
#
#   cp .env.example .env            # fill in the values below
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Compose reads this file for interpolation only. A key reaches the app only if
# docker-compose.prod.yml lists it under web.environment; these are exactly
# those keys. NEXT_PUBLIC_* are build args inlined into the bundle, so changing
# one is a rebuild, not a restart. Everything else is runtime env and never
# enters an image. Never commit the filled-in .env.

# ---------------------------------------------
# REQUIRED (compose refuses to start without these)
# ---------------------------------------------

# Postgres password. It is spliced unencoded into DATABASE_URL, so keep it
# URL-safe:  openssl rand -hex 32
# Postgres applies it only when the pgdata volume is first created; to rotate
# it later, also run ALTER USER in psql.
POSTGRES_PASSWORD=

# The public https URL of the site, e.g. https://outlierclothiers.com.
# Build arg.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------
# NETWORK
# ---------------------------------------------

# Exactly "true" selects Base Sepolia for pricing, escrow and settlement.
# Anything else ("1", "TRUE", empty) means Base MAINNET. Build arg.
NEXT_PUBLIC_TESTNET=false

# Database name and user. Both default to "outlier".
# POSTGRES_USER=outlier
# POSTGRES_DB=outlier

# ---------------------------------------------
# REQUIRED FOR PAYMENTS
# The CDP server wallet receives x402 USDC and buys the escrow slot for every
# rail. With these empty the store runs and no payment settles.
# ---------------------------------------------

# portal.cdp.coinbase.com -> API Keys -> create a Secret API key.
# The secret is shown once, at creation.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# portal.cdp.coinbase.com -> Server Wallet -> generate Wallet Secret.
# Needed whenever the two keys above are set: sending buySlot and creating
# the account use it.
CDP_WALLET_SECRET=

# Name of the CDP EVM account that holds the shop's USDC. Default:
# outlier-server. The first settlement creates an account with this name if
# none exists.
CDP_ACCOUNT_NAME=

# x402 (USDC on Base, EIP-3009). The address buyers pay: set it to the CDP
# wallet's address (above) so the same wallet that receives can fund the
# escrow. Public by nature; it is printed in every 402. Empty disables the
# rail (503).
X402_PAYMENT_ADDRESS=

# ---------------------------------------------
# COINBASE COMMERCE (optional rail)
# ---------------------------------------------

# commerce.coinbase.com -> Settings -> Security -> API keys
COINBASE_COMMERCE_API_KEY=

# commerce.coinbase.com -> Settings -> Notifications -> shared secret.
# /api/webhooks/coinbase refuses every event without it (503) and every
# event it cannot verify with it (401).
COINBASE_WEBHOOK_SECRET=

# ---------------------------------------------
# TELEGRAM STARS (optional rail)
# ---------------------------------------------

# BotFather: /newbot, or /token for an existing bot. BOT_USERNAME is the
# bot's @username without the @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# openssl rand -hex 32, then pass the same value as secret_token to
# setWebhook. /api/webhooks/telegram refuses every update without it (503)
# and every update that does not carry it (401).
TELEGRAM_WEBHOOK_SECRET=

# BotFather -> /mybots -> Payments. Only for fiat provider invoices; Stars
# (XTR) invoices do not use it.
TELEGRAM_PAYMENT_PROVIDER_TOKEN=

# ---------------------------------------------
# ADMIN (optional)
# ---------------------------------------------

# Bearer token for the operator-only routes /api/admin/status and
# /api/shipping/create-label:  Authorization: Bearer <token>
# openssl rand -hex 32. Empty switches those routes off (503).
ADMIN_TOKEN=

# ---------------------------------------------
# OPTIONAL
# ---------------------------------------------

# easypost.com -> API keys. Not used yet: label creation is a placeholder.
EASYPOST_API_KEY=

# AI concierge: an OpenAI-compatible gateway. Without the key the concierge
# is off. Base URL and model have built-in defaults.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=

# Voice concierge transcription: Groq first (console.groq.com -> API Keys),
# else OpenAI (platform.openai.com -> API keys). Neither: voice is off.
GROQ_API_KEY=
OPENAI_API_KEY=

# Host port for web when it is not behind a reverse proxy. Default 3000.
# WEB_PORT=3000
