# ==============================================
# Outlier Clothiers - Required Environment Variables
# ==============================================
# Add these to your Vercel project:
# https://vercel.com/of8/outlier-clothiers/settings/environment-variables

# ---------------------------------------------
# PAYMENT APIS (for future e-commerce)
# ---------------------------------------------

# Coinbase Commerce - Crypto payments
# Sign up at: https://commerce.coinbase.com/
COINBASE_COMMERCE_API_KEY=

# x402 (USDC on Base, EIP-3009). The address buyers pay: set it to the server
# CDP wallet's address so the same wallet that receives can fund the escrow.
# Public by nature; it is printed in every 402. Empty disables the rail.
X402_PAYMENT_ADDRESS=
# Settlement runs through the CDP server wallet (CDP_API_KEY_ID, CDP_API_KEY_SECRET,
# CDP_WALLET_SECRET, CDP_ACCOUNT_NAME) that the Coinbase and Telegram rails already use.

# Telegram Bot - Stars/TON payments
# Bot: @OutlierClothiersBot
TELEGRAM_BOT_TOKEN=

# EasyPost - Shipping labels (optional)
# Sign up at: https://www.easypost.com/
# EASYPOST_API_KEY=

# ---------------------------------------------
# NOTES:
# ---------------------------------------------
# Currently the site is static/informational
# Payment APIs will be needed when e-commerce goes live
# For now, no env vars are strictly required

# ---------------------------------------------
# VERCEL SETUP CHECKLIST:
# ---------------------------------------------
# 1. Go to: https://vercel.com/of8/outlier-clothiers/settings/environment-variables
# 2. Add keys above when payment integration is ready
# 3. Redeploy: Deployments → ... → Redeploy
